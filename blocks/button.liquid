{% if block.settings.label != blank and block.settings.link != blank %}<a class="button button--{{ block.settings.style }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{% endif %}
{% schema %}
{"name":"Button","settings":[{"type":"text","id":"label","label":"Label","default":"Explore"},{"type":"url","id":"link","label":"Link"},{"type":"select","id":"style","label":"Style","default":"primary","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"tertiary","label":"Text"}]}],"presets":[{"name":"Button"}]}
{% endschema %}

