{% if block.settings.image != blank %}<figure class="theme-block-image" {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 50vw, 100vw', alt: block.settings.image.alt | default: block.settings.alt }}{% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption }}</figcaption>{% endif %}</figure>{% endif %}
{% schema %}
{"name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Fallback alt text"},{"type":"text","id":"caption","label":"Caption"}],"presets":[{"name":"Image"}]}
{% endschema %}

