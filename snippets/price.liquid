{% if product.compare_at_price > product.price %}
  <span class="price__compare"><s>{{ product.compare_at_price | money }}</s></span>
{% endif %}
<span class="price__current">{{ product.price | money }}</span>
{% if product.unit_price_measurement %}
  <small class="price__unit">{{ product.unit_price | money }} / {{ product.unit_price_measurement.reference_value }}{{ product.unit_price_measurement.reference_unit }}</small>
{% endif %}
