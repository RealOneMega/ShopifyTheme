<div class="contact-form__row"><div><label for="AddressFirstName-{{ id }}">First name</label><input class="field" id="AddressFirstName-{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div><div><label for="AddressLastName-{{ id }}">Last name</label><input class="field" id="AddressLastName-{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div></div>
<label for="AddressCompany-{{ id }}">Company</label><input class="field" id="AddressCompany-{{ id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
<label for="Address1-{{ id }}">Address</label><input class="field" id="Address1-{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required>
<label for="Address2-{{ id }}">Apartment, suite, etc.</label><input class="field" id="Address2-{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
<div class="contact-form__row"><div><label for="AddressCity-{{ id }}">City</label><input class="field" id="AddressCity-{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required></div><div><label for="AddressCountry-{{ id }}">Country/region</label><select class="field field--select" id="AddressCountry-{{ id }}" name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select></div></div>
<div class="contact-form__row"><div><label for="AddressProvince-{{ id }}">Province/state</label><input class="field" id="AddressProvince-{{ id }}" name="address[province]" value="{{ form.province }}" autocomplete="address-level1"></div><div><label for="AddressZip-{{ id }}">Postal code</label><input class="field" id="AddressZip-{{ id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" required></div></div>
<label for="AddressPhone-{{ id }}">Phone</label><input class="field" id="AddressPhone-{{ id }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
<label><input type="checkbox" name="address[default]" value="1"> Set as default address</label>

