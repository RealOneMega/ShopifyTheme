{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="Pagination">
    {%- if paginate.previous -%}<a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="Previous page">Previous</a>{%- endif -%}
    <ol class="pagination__list" role="list">
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            <span class="pagination__link{% if part.title == paginate.current_page %} is-current{% endif %}"{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if paginate.next -%}<a class="pagination__link" href="{{ paginate.next.url }}" aria-label="Next page">Next</a>{%- endif -%}
  </nav>
{%- endif -%}
