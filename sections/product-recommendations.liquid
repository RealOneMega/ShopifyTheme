<section class="section product-recommendations" data-product-recommendations data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-limit="{{ section.settings.limit }}" data-intent="{{ section.settings.intent }}">
  <div class="container">
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <header class="section__header"><p class="eyebrow">Continue the risk</p><h2 class="heading">{{ section.settings.heading }}</h2></header>
      <div class="product-grid">{% for product in recommendations.products %}{% render 'product-card', product: product, style: 'below' %}{% endfor %}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Recommended for you"},
    {"type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 8, "step": 1, "default": 4},
    {"type": "select", "id": "intent", "label": "Recommendation intent", "default": "related", "options": [{"value": "related", "label": "Related products"}, {"value": "complementary", "label": "Complementary products"}]}
  ]
}
{% endschema %}
