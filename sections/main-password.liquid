<section class="section password-page"><div class="container container--narrow"><div class="password-page__panel">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 560 | image_tag: loading: 'eager', widths: '240, 360, 480, 560', sizes: '240px', alt: shop.name }}{% else %}<strong>{{ shop.name }}</strong>{% endif %}<p class="eyebrow">Push Limits. Define Risk.</p><h1 class="heading">{{ section.settings.heading }}</h1><div class="rte">{{ shop.password_message }}</div>{% form 'customer', class: 'customer-form' %}{% if form.posted_successfully? %}<p class="form-message form-message--success">You’re on the list.</p>{% endif %}{% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<input type="hidden" name="contact[tags]" value="prospect, password page"><label for="PasswordEmail">Email</label><input class="field" id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" required><button class="button button--primary" type="submit">Notify me</button>{% endform %}<details><summary>Store owner access</summary>{% form 'storefront_password', class: 'customer-form' %}{% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="StorePassword">Password</label><input class="field" id="StorePassword" type="password" name="password" autocomplete="current-password" required><button class="button button--secondary" type="submit">Enter store</button>{% endform %}</details></div></div></section>
{% schema %}{"name":"Password page","settings":[{"type":"text","id":"heading","label":"Heading","default":"The next limit is loading"}]}{% endschema %}

