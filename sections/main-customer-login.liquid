<section class="section customer-page"><div class="container container--narrow"><header class="section__header"><p class="eyebrow">Member access</p><h1 class="heading">Sign in</h1></header><div class="customer-auth-grid"><div>{% form 'customer_login', class: 'customer-form' %}{% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="CustomerEmail">Email</label><input class="field" id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required>{% if form.password_needed %}<label for="CustomerPassword">Password</label><input class="field" id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>{% endif %}<button class="button button--primary" type="submit">Sign in</button><a class="button button--secondary" href="{{ routes.account_register_url }}">Create account</a>{% endform %}</div><details class="customer-recovery"><summary>Forgot your password?</summary>{% form 'recover_customer_password', class: 'customer-form' %}{% if form.posted_successfully? %}<p class="form-message form-message--success" role="status">We sent you a recovery email.</p>{% endif %}{% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="RecoverEmail">Email</label><input class="field" id="RecoverEmail" type="email" name="email" autocomplete="email" required><button class="button button--primary" type="submit">Send recovery email</button>{% endform %}</details></div>{% if shop.checkout.guest_login %}{% form 'guest_login' %}<button class="button button--tertiary" type="submit">Continue as guest</button>{% endform %}{% endif %}</div></section>
{% schema %}{"name":"Customer login","settings":[]}{% endschema %}

