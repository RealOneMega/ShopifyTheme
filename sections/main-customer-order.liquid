<section class="section customer-page"><div class="container"><header class="customer-page__header"><div><p class="eyebrow">Order details</p><h1 class="heading">{{ order.name }}</h1><p>Placed {{ order.created_at | time_tag: format: 'date_at_time' }}</p></div><a class="button button--secondary" href="{{ routes.account_url }}">Back to account</a></header>{% if order.cancelled %}<div class="form-message form-message--error">Cancelled {{ order.cancelled_at | time_tag: format: 'date' }}. {{ order.cancel_reason_label }}</div>{% endif %}<div class="responsive-table"><table><thead><tr><th>Product</th><th>SKU</th><th>Price</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for line_item in order.line_items %}<tr><td><a href="{{ line_item.url }}">{{ line_item.title }}</a>{% if line_item.selling_plan_allocation %}<small>{{ line_item.selling_plan_allocation.selling_plan.name }}</small>{% endif %}</td><td>{{ line_item.sku }}</td><td>{{ line_item.final_price | money }}</td><td>{{ line_item.quantity }}</td><td>{{ line_item.final_line_price | money }}</td></tr>{% endfor %}</tbody><tfoot><tr><th colspan="4">Subtotal</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>{% for discount_application in order.cart_level_discount_applications %}<tr><th colspan="4">{{ discount_application.title }}</th><td>−{{ discount_application.total_allocated_amount | money }}</td></tr>{% endfor %}{% for shipping_method in order.shipping_methods %}<tr><th colspan="4">Shipping ({{ shipping_method.title }})</th><td>{{ shipping_method.price | money }}</td></tr>{% endfor %}<tr><th colspan="4">Tax</th><td>{{ order.tax_price | money }}</td></tr><tr><th colspan="4">Total</th><td>{{ order.total_net_amount | money_with_currency }}</td></tr></tfoot></table></div><div class="customer-account-grid"><div><h2>Shipping address</h2>{{ order.shipping_address | format_address }}</div><div><h2>Billing address</h2>{{ order.billing_address | format_address }}</div></div></div></section>
{% schema %}{"name":"Customer order","settings":[]}{% endschema %}

