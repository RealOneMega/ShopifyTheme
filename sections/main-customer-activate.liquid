<section class="section customer-page"><div class="container container--narrow"><header class="section__header"><h1 class="heading">Activate account</h1></header>{% form 'activate_customer_password', class: 'customer-form' %}{% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="ActivatePassword">Password</label><input class="field" id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required><label for="ActivatePasswordConfirmation">Confirm password</label><input class="field" id="ActivatePasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required><button class="button button--primary" type="submit">Activate account</button><button class="button button--secondary" type="submit" name="decline">Decline invitation</button>{% endform %}</div></section>
{% schema %}{"name":"Activate account","settings":[]}{% endschema %}

