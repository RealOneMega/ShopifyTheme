<section class="section customer-page"><div class="container"><header class="customer-page__header"><div><p class="eyebrow">Member profile</p><h1 class="heading">{{ customer.name }}</h1><p>{{ customer.email }}</p></div><a class="button button--secondary" href="{{ routes.account_logout_url }}">Sign out</a></header><div class="customer-account-grid"><div><h2>Order history</h2>{% paginate customer.orders by 20 %}{% if customer.orders.size > 0 %}<div class="responsive-table"><table><thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfillment</th><th>Total</th></tr></thead><tbody>{% for order in customer.orders %}<tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | time_tag: format: 'date' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_net_amount | money_with_currency }}</td></tr>{% endfor %}</tbody></table></div>{% render 'pagination', paginate: paginate %}{% else %}<div class="empty-state"><p>You have not placed an order yet.</p><a class="button button--primary" href="{{ routes.all_products_collection_url }}">Explore products</a></div>{% endif %}{% endpaginate %}</div><aside class="customer-address-summary"><h2>Default address</h2>{% if customer.default_address %}{{ customer.default_address | format_address }}{% else %}<p>No address saved.</p>{% endif %}<a class="button button--secondary" href="{{ routes.account_addresses_url }}">Manage addresses ({{ customer.addresses_count }})</a></aside></div></div></section>
{% schema %}{"name":"Customer account","settings":[]}{% endschema %}

