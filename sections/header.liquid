<section class="header section--background" data-header-section="{{ section.id }}" style="{% render 'section-background-style', section: section %}">
  {% render 'section-background-media', section: section %}
  {% if section.settings.show_utility_row %}
    {% assign utility_alignment = section.settings.utility_alignment | default: 'center' %}
    <div class="header__utility">
      <div class="header__utility-bar header__utility-bar--{{ utility_alignment }}">
        <div class="header__utility-slot header__utility-slot--left">
          {% if section.settings.utility_menu != blank and utility_alignment == 'left' %}
            <nav aria-label="Utility" class="header__utility-links">
              {% for link in section.settings.utility_menu.links %}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </nav>
          {% endif %}
        </div>
        <div class="header__utility-slot header__utility-slot--center">
          {% if section.settings.utility_menu != blank and utility_alignment == 'center' %}
            <nav aria-label="Utility" class="header__utility-links">
              {% for link in section.settings.utility_menu.links %}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </nav>
          {% endif %}
        </div>
        <div class="header__utility-slot header__utility-slot--right">
          {% if section.settings.utility_menu != blank and utility_alignment == 'right' %}
            <nav aria-label="Utility" class="header__utility-links">
              {% for link in section.settings.utility_menu.links %}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </nav>
          {% endif %}
          {% if section.settings.show_localization %}
            {% render 'localization-form', id: section.id, show_country: true, show_language: section.settings.show_language %}
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  {% assign nav_class = 'nav' %}
  {% if section.settings.layout == 'logo_center' %}
    {% assign nav_class = 'nav nav--center' %}
  {% endif %}
  {% capture nav_markup %}
    <nav class="{{ nav_class }}" aria-label="Primary">
      <div class="nav__list">
        {% for link in section.settings.main_menu.links %}
          <div class="nav__item">
          {% if link.links != blank %}
            {%- assign link_key = link.title | handle -%}
            <a class="nav__link" href="{{ link.url }}" data-mega-trigger aria-haspopup="true" aria-expanded="false" aria-controls="MegaMenu-{{ section.id }}-{{ link_key }}">{{ link.title }}</a>
            <div class="nav__dropdown" id="MegaMenu-{{ section.id }}-{{ link_key }}" aria-hidden="true">
              {% for child in link.links %}
                <div>
                  <a href="{{ child.url }}"><strong>{{ child.title }}</strong></a>
                  {% if child.links != blank %}
                    <div class="stack" style="margin-top:0.5rem;">
                      {% for grandchild in child.links %}
                        <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
              {% for block in section.blocks %}
                {%- assign block_parent = block.settings.parent_link | handle -%}
                {% if block_parent == link_key %}
                  {% case block.type %}
                    {% when 'promo' %}
                      <a class="mega-menu__feature" href="{{ block.settings.link | default: link.url }}" {{ block.shopify_attributes }}>
                        {% if block.settings.image != blank %}
                          {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 360, 480, 640', sizes: '280px', alt: block.settings.heading }}
                        {% endif %}
                        {% if block.settings.heading != blank %}<strong>{{ block.settings.heading }}</strong>{% endif %}
                        {% if block.settings.text != blank %}<span>{{ block.settings.text }}</span>{% endif %}
                      </a>
                    {% when 'featured_collection' %}
                      {% assign featured_collection = block.settings.collection %}
                      {% if featured_collection != blank %}
                        <a class="mega-menu__feature" href="{{ featured_collection.url }}" {{ block.shopify_attributes }}>
                          {% if featured_collection.featured_image != blank %}
                            {{ featured_collection.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 360, 480, 640', sizes: '280px', alt: featured_collection.title }}
                          {% endif %}
                          <strong>{{ block.settings.heading | default: featured_collection.title }}</strong>
                        </a>
                      {% endif %}
                    {% when 'featured_product' %}
                      {% assign featured_product = block.settings.product %}
                      {% if featured_product != blank %}
                        <a class="mega-menu__feature" href="{{ featured_product.url }}" {{ block.shopify_attributes }}>
                          {% if featured_product.featured_image != blank %}
                            {{ featured_product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 360, 480, 640', sizes: '280px', alt: featured_product.title }}
                          {% endif %}
                          <strong>{{ block.settings.heading | default: featured_product.title }}</strong>
                          <span>{{ featured_product.price | money }}</span>
                        </a>
                      {% endif %}
                  {% endcase %}
                {% endif %}
              {% endfor %}
            </div>
          {% else %}
          <a class="nav__link" href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        </div>
      {% endfor %}
      </div>
    </nav>
  {% endcapture %}

  <div class="header__sticky {% if section.settings.sticky %}header__sticky--enabled{% endif %}">
    <div class="header__main {% if section.settings.layout == 'logo_center' %}header__main--center{% endif %}">
      <button class="header__icon-button header__menu-toggle" type="button" data-drawer-open="#mobile-menu" aria-controls="mobile-menu" aria-expanded="false" aria-label="{{ 'accessibility.open_menu' | t }}">
        {% render 'icon-menu' %}
      </button>

      <div class="header__logo {% if section.settings.layout == 'logo_center' %}header__logo--center{% else %}header__logo--left{% endif %}" style="max-width:{{ section.settings.logo_width }}px;">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {% if settings.logo != blank %}
            <picture>
              {% if settings.logo_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ settings.logo_mobile | image_url: width: 480 }}">{% endif %}
              {{ settings.logo | image_url: width: 560 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '160, 240, 320, 480, 560', sizes: '(max-width: 749px) 150px, 220px', alt: shop.name, class: 'header__logo-image' }}
            </picture>
          {% else %}
            <strong>{{ shop.name }}</strong>
          {% endif %}
        </a>
      </div>

      {% if section.settings.layout == 'logo_left' %}
        {% assign menu_alignment = 'center' %}
        {% if section.settings.menu_position == 'right' %}
          {% assign menu_alignment = 'end' %}
        {% endif %}
        <div style="justify-self:{{ menu_alignment }};">
          {{ nav_markup }}
        </div>
      {% endif %}

      <div class="header__icons header__icons--desktop" style="justify-self:end;">
        <button class="header__icon-button" type="button" data-drawer-open="#search-drawer" aria-controls="search-drawer" aria-expanded="false" aria-label="{{ 'accessibility.open_search' | t }}">
          {% render 'icon-search' %}
        </button>
        <a class="header__icon-button" href="{{ routes.account_url }}" aria-label="Account">
          {% render 'icon-account' %}
        </a>
        {% if settings.enable_wishlist %}
          <button class="header__icon-button" type="button" data-drawer-open="#wishlist-drawer" aria-controls="wishlist-drawer" aria-expanded="false" aria-label="{{ 'wishlist.title' | t }}">
            {% render 'icon-heart' %}
            <span class="header__badge hidden" data-wishlist-count aria-live="polite">0</span>
          </button>
        {% endif %}
        <button class="header__icon-button" type="button" data-drawer-open="#cart-drawer" aria-controls="cart-drawer" aria-expanded="false" aria-label="{{ 'accessibility.open_cart' | t }}">
          {% render 'icon-cart' %}
          <span class="header__badge{% if cart.item_count == 0 %} hidden{% endif %}" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
        </button>
        <a class="header__icon-button no-js-cart-link" href="{{ routes.cart_url }}" aria-label="{{ 'cart.title' | t }}">{% render 'icon-cart' %}</a>
      </div>
    </div>

    {% if section.settings.layout == 'logo_center' %}
      {{ nav_markup }}
    {% endif %}
  </div>
</section>

<div id="mobile-menu" class="drawer" role="dialog" aria-modal="true" aria-labelledby="MobileMenuTitle" aria-hidden="true">
  <div class="drawer__header">
    <strong id="MobileMenuTitle">Menu</strong>
    <button class="header__icon-button" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
  </div>
  <div class="drawer__content">
    <div class="mobile-menu__icons">
      <button class="header__icon-button" type="button" data-drawer-open="#search-drawer" aria-controls="search-drawer" aria-expanded="false" aria-label="{{ 'accessibility.open_search' | t }}">
        {% render 'icon-search' %}
      </button>
      <a class="header__icon-button" href="{{ routes.account_url }}" aria-label="Account">
        {% render 'icon-account' %}
      </a>
      {% if settings.enable_wishlist %}
        <button class="header__icon-button" type="button" data-drawer-open="#wishlist-drawer" aria-controls="wishlist-drawer" aria-expanded="false" aria-label="{{ 'wishlist.title' | t }}">
          {% render 'icon-heart' %}
          <span class="header__badge hidden" data-wishlist-count aria-live="polite">0</span>
        </button>
      {% endif %}
      <button class="header__icon-button" type="button" data-drawer-open="#cart-drawer" aria-controls="cart-drawer" aria-expanded="false" aria-label="{{ 'accessibility.open_cart' | t }}">
        {% render 'icon-cart' %}
        <span class="header__badge{% if cart.item_count == 0 %} hidden{% endif %}" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
      </button>
      <a class="header__icon-button no-js-cart-link" href="{{ routes.cart_url }}" aria-label="{{ 'cart.title' | t }}">{% render 'icon-cart' %}</a>
    </div>
    <nav aria-label="Mobile">
      {% for link in section.settings.main_menu.links %}
        <div class="mobile-menu__item">
          <div class="mobile-menu__row">
            <a class="mobile-menu__link" href="{{ link.url }}">{{ link.title }}</a>
            {% if link.links != blank %}
              <button class="mobile-menu__toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-label="Toggle {{ link.title }} submenu">
                <span class="mobile-menu__toggle-icon" aria-hidden="true"></span>
              </button>
            {% endif %}
          </div>
          {% if link.links != blank %}
            <div class="mobile-menu__submenu" aria-hidden="true">
              {% for child in link.links %}
                <div class="mobile-menu__item">
                  <div class="mobile-menu__row">
                    <a class="mobile-menu__link" href="{{ child.url }}">{{ child.title }}</a>
                    {% if child.links != blank %}
                      <button class="mobile-menu__toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-label="Toggle {{ child.title }} submenu">
                        <span class="mobile-menu__toggle-icon" aria-hidden="true"></span>
                      </button>
                    {% endif %}
                  </div>
                  {% if child.links != blank %}
                    <div class="mobile-menu__submenu" aria-hidden="true">
                      {% for grandchild in child.links %}
                        <a class="mobile-menu__link" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>
  </div>
</div>

<div id="search-drawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="SearchDrawerTitle" aria-hidden="true">
  <div class="drawer__header">
    <strong id="SearchDrawerTitle">{{ 'search.title' | t }}</strong>
    <button class="header__icon-button" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
  </div>
  <div class="drawer__content">
    <form action="{{ routes.search_url }}" method="get" role="search" data-predictive-search>
      <label for="SearchInput-{{ section.id }}">{{ 'general.search' | t }}</label>
      <input class="field" id="SearchInput-{{ section.id }}" type="search" name="q" placeholder="Search products" autocomplete="off" autofocus>
      <div class="predictive-search" id="PredictiveResults-{{ section.id }}" data-predictive-results hidden></div>
      <button class="button button--primary" type="submit">{{ 'general.search' | t }}</button>
    </form>
  </div>
</div>

{% if settings.enable_wishlist %}
<div id="wishlist-drawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="WishlistDrawerTitle" aria-hidden="true">
  <div class="drawer__header">
    <strong id="WishlistDrawerTitle">{{ 'wishlist.title' | t }}</strong>
    <button class="header__icon-button" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
  </div>
  <div class="drawer__content">
    <div data-wishlist-items>
      <p>{{ 'wishlist.empty' | t }}</p>
    </div>
  </div>
</div>
{% endif %}

<div id="cart-drawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" aria-hidden="true" data-cart-drawer>
  <div class="drawer__header">
    <strong id="CartDrawerTitle">{{ 'cart.title' | t }}</strong>
    <button class="header__icon-button" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
  </div>
  <div class="drawer__content" data-cart-drawer-content>
    <div data-cart-drawer-empty{% unless cart.item_count == 0 %} class="hidden"{% endunless %}>
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button button--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
    </div>
    <div data-cart-drawer-filled{% if cart.item_count == 0 %} class="hidden"{% endif %}>
      <div class="stack" data-cart-drawer-items>
        {% for item in cart.items %}
          <div class="cart-drawer-item" data-cart-line-key="{{ item.key }}">
            <a href="{{ item.url }}">{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}</a>
            <div class="cart-drawer-item__details">
              <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
              {% unless item.variant.title == 'Default Title' %}<span class="cart-drawer-item__variant">{{ item.variant.title }}</span>{% endunless %}
              {% if item.selling_plan_allocation != blank %}<span>{{ item.selling_plan_allocation.selling_plan.name }}</span>{% endif %}
              <div>{{ item.final_line_price | money }}</div>
              <div class="quantity-control" aria-label="Quantity for {{ item.product.title | escape }}">
                <button type="button" data-cart-quantity="{{ item.quantity | minus: 1 | at_least: 0 }}" aria-label="Decrease quantity">−</button>
                <span aria-live="polite">{{ item.quantity }}</span>
                <button type="button" data-cart-quantity="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">+</button>
              </div>
              <button class="button button--tertiary" type="button" data-cart-remove>{{ 'cart.remove' | t: title: item.product.title }}</button>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="cart-drawer-summary">
        {% if settings.free_shipping_threshold > 0 %}
          {% assign shipping_goal = settings.free_shipping_threshold | times: 100 %}
          {% assign shipping_percent = cart.total_price | times: 100 | divided_by: shipping_goal | at_most: 100 %}
          {% assign shipping_remaining = shipping_goal | minus: cart.total_price | at_least: 0 %}
          <div class="free-shipping-progress" data-free-shipping-progress>
            <p data-free-shipping-message>{% if shipping_remaining > 0 %}Add {{ shipping_remaining | money }} for free shipping.{% else %}You reached the free-shipping goal.{% endif %}</p>
            <div class="free-shipping-progress__bar" role="progressbar" aria-label="Free-shipping progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shipping_percent }}" data-free-shipping-bar style="--progress: {{ shipping_percent }}%;"></div>
          </div>
        {% endif %}
        <strong>{{ 'cart.subtotal' | t }}: <span data-cart-drawer-total>{{ cart.total_price | money }}</span></strong>
        <a class="button button--secondary" href="{{ routes.cart_url }}">View cart</a>
        <form action="{{ routes.cart_url }}" method="post">
          <button class="button button--primary" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </form>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "logo_left",
      "options": [
        {
          "value": "logo_left",
          "label": "Logo left"
        },
        {
          "value": "logo_center",
          "label": "Logo center"
        }
      ]
    },
    {
      "type": "select",
      "id": "menu_position",
      "label": "Menu position (logo left)",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_utility_row",
      "label": "Show utility row",
      "default": false
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 280,
      "step": 10,
      "default": 180,
      "unit": "px"
    },
    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "Utility menu"
    },
    {
      "type": "select",
      "id": "utility_alignment",
      "label": "Utility menu alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right (next to selector)"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Solid color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#08090b"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video"
    },
    {
      "type": "range",
      "id": "background_position_x",
      "label": "Background position horizontal",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "background_position_y",
      "label": "Background position vertical",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background size",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "select",
      "id": "background_repeat",
      "label": "Background repeat",
      "default": "no-repeat",
      "options": [
        {
          "value": "no-repeat",
          "label": "No repeat"
        },
        {
          "value": "repeat",
          "label": "Repeat"
        },
        {
          "value": "repeat-x",
