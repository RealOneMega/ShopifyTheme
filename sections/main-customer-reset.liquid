<section class="section customer-page"><div class="container container--narrow"><header class="section__header"><h1 class="heading">Reset password</h1></header>{% form 'reset_customer_password', class: 'customer-form' %}{% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="ResetPassword">Password</label><input class="field" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required><label for="ResetPasswordConfirmation">Confirm password</label><input class="field" id="ResetPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required><button class="button button--primary" type="submit">Reset password</button>{% endform %}</div></section>
{% schema %}{"name":"Reset password","settings":[]}{% endschema %}

