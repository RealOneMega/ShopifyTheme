<section class="section customer-page"><div class="container container--narrow"><header class="section__header"><p class="eyebrow">Member access</p><h1 class="heading">Create account</h1></header>{% form 'create_customer', class: 'customer-form' %}{% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<div class="contact-form__row"><div><label for="RegisterFirstName">First name</label><input class="field" id="RegisterFirstName" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div><div><label for="RegisterLastName">Last name</label><input class="field" id="RegisterLastName" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div></div><label for="RegisterEmail">Email</label><input class="field" id="RegisterEmail" type="email" name="customer[email]" value="{{ form.email }}" autocomplete="email" required><label for="RegisterPassword">Password</label><input class="field" id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required><button class="button button--primary" type="submit">Create account</button><a class="button button--tertiary" href="{{ routes.account_login_url }}">Already have an account?</a>{% endform %}</div></section>
{% schema %}{"name":"Customer register","settings":[]}{% endschema %}

