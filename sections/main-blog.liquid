<section class="section">
  <div class="container">
    <header class="section__header"><p class="eyebrow">Field notes</p><h1 class="heading">{{ blog.title }}</h1></header>
    {% paginate blog.articles by section.settings.articles_per_page %}
      {% if blog.articles_count > 0 %}
        <div class="article-grid">
          {% for article in blog.articles %}
            <article class="article-card">
              {% if article.image != blank %}<a href="{{ article.url }}">{{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt | default: article.title }}</a>{% endif %}
              <div class="article-card__content">
                <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
                <h2 class="h3"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
                <a class="button button--tertiary" href="{{ article.url }}">Read story</a>
              </div>
            </article>
          {% endfor %}
        </div>
        {% render 'pagination', paginate: paginate %}
      {% else %}
        <div class="empty-state"><p>No stories have been published yet.</p></div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{"name":"Main blog","settings":[{"type":"range","id":"articles_per_page","label":"Articles per page","min":6,"max":24,"step":3,"default":12}]}
{% endschema %}

