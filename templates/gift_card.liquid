<script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
<section class="section gift-card-page"><div class="container container--narrow"><div class="gift-card"><p class="eyebrow">{{ shop.name }}</p><h1 class="heading">Gift card</h1><p class="gift-card__value">{{ gift_card.initial_value | money_with_currency }}</p>{% if gift_card.enabled == false or gift_card.expired %}<p class="form-message form-message--error">This gift card is no longer active.</p>{% endif %}<div class="gift-card__qr" data-gift-card-qr="{{ gift_card.qr_identifier }}" aria-label="Gift card QR code"></div><p>Use this code at checkout:</p><button class="gift-card__code" type="button" data-copy-button data-copy-text="{{ gift_card.code }}">{{ gift_card.code | format_code }}</button><p>Balance: {{ gift_card.balance | money_with_currency }}</p>{% if gift_card.expires_on %}<p>Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>{% endif %}<a class="button button--primary" href="{{ shop.url }}{{ routes.root_url }}">Shop now</a><button class="button button--secondary" type="button" data-print-button>Print</button></div></div></section>
